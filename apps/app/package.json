{
  "name": "@exporthq/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types:cloudflare": "WRANGLER_LOG_PATH=/tmp/exporthq-wrangler-types.log wrangler types --config wrangler.jsonc --include-runtime false --check",
    "check:vinext": "vinext check",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "dry-run:cloudflare": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.4",
    "@exporthq/auth": "workspace:*",
    "@exporthq/authorization": "workspace:*",
    "@exporthq/db": "workspace:*",
    "@exporthq/domain": "workspace:*",
    "@exporthq/platform": "workspace:*",
    "@exporthq/ui": "workspace:*",
    "@exporthq/validation": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
