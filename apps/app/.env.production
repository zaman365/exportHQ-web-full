# Non-secret, public production facts used at build time.
#
# The Content Security Policy in next.config.ts is generated from the origins a
# deployment actually uses. This one is the Clerk Frontend API origin for the
# production instance on export-hq.com; it is public (the browser fetches Clerk
# from it) and belongs in the build rather than in a Worker secret.
NEXT_PUBLIC_CLERK_FRONTEND_API_ORIGIN=https://clerk.export-hq.com
NEXT_PUBLIC_SITE_URL=https://export-hq.com
NEXT_PUBLIC_APP_URL=https://export-hq.com/ExportPanel
