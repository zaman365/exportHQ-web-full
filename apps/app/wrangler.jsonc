{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exporthq-app",
  "compatibility_date": "2026-08-29",
  // The PostgreSQL driver needs Node built-ins. Neon's pooled connection string
  // is required alongside this; `createDatabase` sets `prepare: false` so the
  // pooler cannot carry prepared statements across sessions.
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "export-hq.com/ExportPanel*",
      "zone_name": "export-hq.com"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    // The runtime authority for what "production" means. Preview adapters,
    // demo identity and every unactivated capability fail closed on this.
    "EXPORTHQ_ENVIRONMENT": "production",
    "EXPORTHQ_DEMO_MODE": "false",
    "EXPORTHQ_WEB_URL": "https://export-hq.com",
    "EXPORTHQ_AUTHORIZED_PARTIES": "https://export-hq.com",
    // Gate identifiers are added here only from recorded evidence.
    // See docs/activation-gates.md.
    "EXPORTHQ_ACTIVATION_GATES_PASSED": ""
  }
}
