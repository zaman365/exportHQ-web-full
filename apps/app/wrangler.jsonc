{
  "name": "exporthq-app",
  "compatibility_date": "2026-08-20",
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "trevv.export-hq.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "vars": {
    "EXPORTHQ_DEMO_MODE": "true",
    "EXPORTHQ_WEB_URL": "https://exporthq-web.zaman-ase365.workers.dev"
  }
}
