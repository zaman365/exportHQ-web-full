# Authentication (Clerk)
NEXT_PUBLIC_SITE_URL=https://export-hq.com
NEXT_PUBLIC_APP_URL=https://export-hq.com/ExportPanel
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: lets the Worker verify Clerk sessions without a network request.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated origins that may present a Clerk session to ExportPanel.
EXPORTHQ_AUTHORIZED_PARTIES=https://export-hq.com,http://localhost:3001
# Optional, server-only comma-separated allowlist. These users must still
# authenticate with Clerk and join an organization before receiving Managed access.
EXPORTHQ_PLATFORM_ADMIN_EMAILS=
# Dedicated operations identities. Production Ops also fails closed unless the
# session carries an MFA/aal2 claim and a database staff profile/grant exists.
EXPORTHQ_STAFF_EMAILS=
EXPORTHQ_OPS_REQUIRE_MFA=true

# PostgreSQL (Neon, EU region)
DATABASE_URL=
# Explicit adapter override is allowed only outside production. Production
# always requires PostgreSQL and refuses memory stores.
EXPORTHQ_PLATFORM_STORE=memory

# Private object storage (Cloudflare R2, EU jurisdiction)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Production activation gates. Comma-separated `gate-id=evidence-reference`
# pairs; a gate without an evidence reference is ignored. Capabilities such as
# document upload and mailbox connection fail closed until their gate is
# recorded. See docs/activation-gates.md.
EXPORTHQ_ACTIVATION_GATES_PASSED=
# Evidence reference for reconciled self-service billing. A Clerk key alone is
# never sufficient and this stays empty until the R4 billing controls pass.
EXPORTHQ_BILLING_ACTIVATION_EVIDENCE=

# production | preview | development | test. Decides whether preview adapters
# may run at all. An unset value with NODE_ENV=production is treated as
# production.
EXPORTHQ_ENVIRONMENT=development

# Security headers. The Content Security Policy is report-only until the
# hardening gate records evidence; set to `enforce` to override.
EXPORTHQ_CSP_MODE=
EXPORTHQ_CSP_REPORT_URI=
EXPORTHQ_EVIDENCE_ORIGINS=
NEXT_PUBLIC_CLERK_FRONTEND_API_ORIGIN=

# Local-only preview identity. Production config must keep this false.
EXPORTHQ_DEMO_MODE=false
EXPORTHQ_DEMO_USER_ID=user_demo_owner
EXPORTHQ_DEMO_ORGANIZATION_ID=org_abc_textiles
