# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: lets the Worker verify Clerk sessions without a network request.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated origins that may present a Clerk session to ExportPanel.
EXPORTHQ_AUTHORIZED_PARTIES=https://export-hq.com,http://localhost:3001
# Optional, server-only comma-separated allowlist. These users must still
# authenticate with Clerk and join an organization before receiving Managed access.
EXPORTHQ_PLATFORM_ADMIN_EMAILS=

# PostgreSQL (Neon, EU region)
DATABASE_URL=

# Private object storage (Cloudflare R2, EU jurisdiction)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local-only preview identity. Production config must keep this false.
EXPORTHQ_DEMO_MODE=false
EXPORTHQ_DEMO_USER_ID=user_demo_owner
EXPORTHQ_DEMO_ORGANIZATION_ID=org_abc_textiles
