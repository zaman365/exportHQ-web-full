{
  "name": "@exporthq/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migration:checksum": "node ./scripts/migration-checksums.mjs validate",
    "migration:checksum:update": "node ./scripts/migration-checksums.mjs update",
    "db:reset:test": "node ./scripts/db-test.mjs reset",
    "db:migrate:test": "node ./scripts/db-test.mjs migrate",
    "db:seed:test": "node ./scripts/db-test.mjs seed",
    "db:backup:test": "node ./scripts/db-test.mjs backup",
    "db:restore:test": "node ./scripts/db-test.mjs restore",
    "lint": "eslint src drizzle.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exporthq/authorization": "workspace:*",
    "@exporthq/domain": "workspace:*",
    "@exporthq/platform": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
